---
/** Wraps inline text with a rough pencil underline drawn beneath it. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["u", className]}>
  <slot />
  <svg viewBox="0 0 200 8" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M2 5.5 C 40 3.2, 80 6.8, 120 4.4 S 170 5.6, 198 3.6"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"></path>
  </svg>
</span>

<style>
  .u {
    position: relative;
    display: inline-block;
  }
  svg {
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: -0.12em;
    width: calc(100% + 0.1em);
    height: 0.28em;
    color: var(--ink);
    opacity: 0.9;
  }
</style>
