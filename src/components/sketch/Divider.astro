---
/**
 * A slightly imperfect pencil rule. Stretches to its container.
 * Optional `label` sits in the line like a drafting note.
 */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div class:list={["divider", className]} role="presentation">
  <svg viewBox="0 0 600 6" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 3.4 C 60 2.1, 120 4.6, 200 3.1 S 320 4.4, 420 2.7 S 540 3.9, 600 2.9"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      vector-effect="non-scaling-stroke"
      stroke-linecap="round"></path>
  </svg>
  {label && <span class="mono hand label">{label}</span>}
</div>

<style>
  .divider {
    position: relative;
    color: var(--stroke);
    height: 6px;
  }
  svg {
    width: 100%;
    height: 6px;
  }
  .label {
    position: absolute;
    right: 0;
    top: -0.9rem;
    padding-left: 0.5rem;
    background: var(--paper);
    font-size: var(--text-sm);
    color: var(--graphite);
  }
</style>
