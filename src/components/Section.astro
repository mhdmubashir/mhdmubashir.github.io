---
/**
 * A numbered notebook section. On wide screens the number sits in the
 * left margin column beside the vertical margin rule; on narrow screens it
 * stacks above the heading.
 */
interface Props {
  id: string;
  number: string; // "01"
  title: string;
  /** Optional handwritten note shown in the margin under the number. */
  note?: string;
}
const { id, number, title, note } = Astro.props;
const headingId = `${id}-title`;
---

<section {id} class="section" aria-labelledby={headingId}>
  <div class="margin">
    <span class="mono num" aria-hidden="true">{number}</span>
    {note && <span class="hand note">{note}</span>}
  </div>
  <div class="body">
    <h2 id={headingId} class="title">
      <span class="sr-only">{number}. </span>{title}
    </h2>
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-12);
    border-top: 1px solid var(--stroke-2);
  }
  .margin {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .num {
    color: var(--ink);
  }
  .note {
    font-size: 0.95rem;
    color: var(--graphite);
  }
  .title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 64rem) {
    .section {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      padding-block: var(--space-16);
    }
    .margin {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding-top: 0.55rem;
      padding-right: var(--space-4);
    }
    .note {
      max-width: 5.5rem;
      line-height: 1.2;
    }
  }
</style>
